# ==============================================================================
# AutoStock — PRODUCTION environment
# ==============================================================================
# Copy to .env (or paste into Coolify's Environment Variables) and fill in.
# These are the ONLY variables the app actually reads — nothing else is needed.
# Never commit the filled-in file.
# ==============================================================================

# --- Secrets (generate fresh — do NOT reuse dev values) ----------------------
# Postgres password.            generate:  openssl rand -base64 24
DB_PASSWORD=CHANGE_ME
# JWT signing key. The backend PANICS on boot in production if this is left at
# its default, so it must be set.   generate:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# --- Core --------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=info
# JWT_EXPIRY_HOURS=24          # optional, defaults to 24

# --- Image storage -----------------------------------------------------------
# STRONGLY recommended in production: put photos in an object bucket so the VPS
# stays stateless for images and they survive a rebuild. See docs/DEPLOYMENT.md.
#
#   local -> on-disk volume (default; fine to start, but back up the volume)
#   r2    -> Cloudflare R2
#   s3    -> any S3-compatible bucket (AWS S3, Backblaze B2, DO Spaces, MinIO)
STORAGE_DRIVER=local

# Cloudflare R2 (only when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=            # public/CDN base URL for the bucket

# Generic S3 (only when STORAGE_DRIVER=s3)
# S3_ENDPOINT blank = AWS S3; set for others (e.g. Backblaze/DO/MinIO).
# S3_FORCE_PATH_STYLE=true for MinIO.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# --- Frontend build arg ------------------------------------------------------
# The frontend nginx proxies /api to the backend on the same origin, so the
# default is correct. Only change if you serve the API from a different host.
VITE_API_URL=/api/v1

# ==============================================================================
# NOT set here on purpose:
#   * DATABASE_URL — built automatically from DB_PASSWORD in the compose file.
#   * Telegram — configured inside the app (Settings -> Telegram: bot token +
#     chat IDs per channel), NOT via environment variables.
#   * Exchange rate, tax, invoice prefix, low-stock threshold — all managed in
#     the app's Settings screen, not env.
# ==============================================================================
