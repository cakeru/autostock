# ==============================================================================
# AutoStock Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
DB_PASSWORD=your-secure-password-here
DB_NAME=autostock
DB_USER=autostock
DB_HOST=localhost
DB_PORT=5432

# Full database URL (constructed from above values)
# For development:
DATABASE_URL=postgres://autostock:your-secure-password-here@localhost:5432/autostock?sslmode=disable
# For Docker:
# DATABASE_URL=postgres://autostock:your-secure-password-here@postgres:5432/autostock?sslmode=disable

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
# JWT secret for token signing (generate with: openssl rand -base64 48)
JWT_SECRET=your-jwt-secret-here-min-32-chars-long

# Backend server port
BACKEND_PORT=8080

# API URL (used for CORS and internal calls)
API_URL=http://localhost:8080/api/v1

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Environment: development, staging, production
APP_ENV=development

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
# Frontend dev server port
FRONTEND_PORT=3000

# API URL for frontend (must match backend API_URL)
# For development:
VITE_API_URL=/api/v1
# For production:
# VITE_API_URL=https://your-domain.com/api/v1

# Application name (displayed in UI)
VITE_APP_NAME=AutoStock

# ------------------------------------------------------------------------------
# Image Storage
# ------------------------------------------------------------------------------
# Where uploaded images are stored/served.
#   local  -> files on the uploads volume, served by the backend at /uploads (default)
#   r2     -> Cloudflare R2 (preset); fill the R2_* values below
#   s3     -> any S3-compatible bucket (AWS S3, Backblaze B2, DO Spaces, MinIO); fill S3_*
STORAGE_DRIVER=local

# Local driver: filesystem dir (inside the backend container) and the URL prefix
# uploaded images are served under. Defaults below match docker-compose.
UPLOAD_DIR=/app/uploads
STORAGE_PUBLIC_URL=/uploads

# Cloudflare R2 (only needed when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public/CDN base URL for the bucket, e.g. https://images.your-domain.com
R2_PUBLIC_URL=

# Generic S3-compatible bucket (only needed when STORAGE_DRIVER=s3)
# S3_ENDPOINT: leave blank for AWS S3; set for others, e.g.
#   Backblaze B2  https://s3.us-west-004.backblazeb2.com
#   DO Spaces     https://nyc3.digitaloceanspaces.com
#   MinIO         https://minio.your-domain.com  (also set S3_FORCE_PATH_STYLE=true)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public/CDN base URL for the bucket, e.g. https://images.your-domain.com
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# One-time move of existing local files into the bucket after switching drivers:
#   docker compose run --rm --entrypoint /app/migrate-storage backend -dry-run
#   docker compose run --rm --entrypoint /app/migrate-storage backend

# ------------------------------------------------------------------------------
# Telegram Bot Configuration (Optional)
# ------------------------------------------------------------------------------
# Enable/disable Telegram bot integration
TELEGRAM_ENABLED=false

# Telegram Bot API token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (group/channel ID for notifications)
# To get chat ID: send message to bot, then check:
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
# Default exchange rate (USD to KHR)
DEFAULT_EXCHANGE_RATE=4050

# Default tax rate (percentage)
DEFAULT_TAX_RATE=0

# Enable tax calculation by default
TAX_ENABLED=false

# Invoice number prefix
INVOICE_PREFIX=INV

# Low stock alert threshold
LOW_STOCK_THRESHOLD=5

# ------------------------------------------------------------------------------
# Security Configuration
# ------------------------------------------------------------------------------
# Enable HTTPS (for production)
HTTPS_ENABLED=false

# SSL certificate paths (if HTTPS_ENABLED=true)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ------------------------------------------------------------------------------
# Backup Configuration
# ------------------------------------------------------------------------------
# Backup directory path
BACKUP_DIR=/opt/autostock/backups

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Enable automatic backups
AUTO_BACKUP_ENABLED=true

# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# ------------------------------------------------------------------------------
# Monitoring & Debugging
# ------------------------------------------------------------------------------
# Enable pprof profiling (development only)
PPROF_ENABLED=false

# Enable Swagger API documentation
SWAGGER_ENABLED=true

# Health check endpoint
HEALTH_CHECK_ENABLED=true

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
# Enable/disable features
FEATURE_MULTI_BRANCH=false
FEATURE_TELEGRAM=false
FEATURE_TAX_CALCULATION=false
FEATURE_LOYALTY_PROGRAM=false
FEATURE_CONSUMABLES=false

# ------------------------------------------------------------------------------
# Development Only
# ------------------------------------------------------------------------------
# Hot reload for backend (development)
HOT_RELOAD=true

# Mock external services (development)
MOCK_TELEGRAM=true

# Seed database with test data (development)
SEED_DATABASE=true

# ------------------------------------------------------------------------------
# Production Deployment
# ------------------------------------------------------------------------------
# Domain name (for production)
# DOMAIN=your-domain.com

# Admin email (for SSL certificate)
# ADMIN_EMAIL=admin@your-domain.com

# VPS IP address
# VPS_IP=your-vps-ip

# ------------------------------------------------------------------------------
# Notes
# ------------------------------------------------------------------------------
# 1. Generate secure passwords:
#    openssl rand -base64 32
#
# 2. Generate JWT secret:
#    openssl rand -base64 48
#
# 3. For production, always use:
#    - Strong passwords (32+ characters)
#    - HTTPS enabled
#    - LOG_LEVEL=info or warn
#    - APP_ENV=production
#    - SWAGGER_ENABLED=false
#    - PPROF_ENABLED=false
#
# 4. Never commit .env file to version control
# 5. Use different .env files for different environments
# 6. Rotate secrets regularly
# ==============================================================================
